// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth & User Models
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  /// When this user accepted the Terms and Privacy Policy, and which version.
  /// Nullable because accounts created before consent was recorded genuinely
  /// have no record — writing a default would fabricate evidence of consent.
  consentedAt      DateTime?
  consentVersion   String?
  /// Set by POST /account/dev-unlock when a valid, unexpired code is
  /// redeemed. The expiry stored here is fixed server-side at code-creation
  /// time — every check compares against the SERVER's clock, never the
  /// device's, so changing the phone's local time cannot extend or fake it.
  devUnlockedUntil DateTime?
  /// Pay in 4's ONE funding account — a FundingInstrument.id, not enforced as
  /// a DB foreign key so disconnecting that bank (routes/plaid.ts's DELETE
  /// /plaid/items/:id) can clear this with a plain update rather than
  /// fighting a FK constraint. Null means "not chosen yet" (assessAccess
  /// auto-picks the first eligible — non-credit — linked account) or "the
  /// chosen one was disconnected." Settings' account picker
  /// (PayIn4AccountPicker.tsx) is the only place this is set deliberately;
  /// see CLAUDE.md's Linked banks section.
  payIn4InstrumentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authAccounts        AuthAccount[]
  oauthTokens         OAuthToken[]
  dataSources         DataSource[]
  fundingInstruments  FundingInstrument[]
  subscriptions       Subscription[]
  subscriptionCharges SubscriptionCharge[]
  transactions        Transaction[]
  allocationPlans     AllocationPlan[]
  ledgerEntries       LedgerEntry[]
  featureFlags        UserFeatureFlag[]
  plaidItems          PlaidItem[]

  // Automated goal savings engine
  fundingSources      FundingSource[]
  savingsGoals        SavingsGoal[]
  savingsSettings     SavingsSettings?
  internalAccounts    InternalAccount[]
  transfers           Transfer[]
  sweepRuns           SweepRun[]

  // Pay in 4 installment engine
  installmentPlans    InstallmentPlan[]

  @@index([email])
}

enum AuthProvider {
  google
  apple
  microsoft
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum OAuthProvider {
  gmail
  outlook
}

model OAuthToken {
  id              String        @id @default(cuid())
  userId          String
  provider        OAuthProvider
  accessTokenEnc  String        @db.Text
  refreshTokenEnc String        @db.Text
  expiry          DateTime
  scopes          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum DataSourceType {
  gmail
  outlook
  imap
  sms
  csv
  eml_upload
}

enum DataSourceStatus {
  active
  error
  disabled
}

model DataSource {
  id        String           @id @default(cuid())
  userId    String
  type      DataSourceType
  status    DataSourceStatus @default(active)
  config    Json? // For IMAP credentials, etc.
  lastSyncAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Funding & Wallet Models
// ============================================================================

enum FundingInstrumentType {
  card
  bank
}

enum CardBrand {
  Visa
  Mastercard
  Amex
  Discover
  Bank
  Unknown
}

model FundingInstrument {
  id              String                @id @default(cuid())
  userId          String
  type            FundingInstrumentType
  displayName     String
  brand           CardBrand
  last4           String
  networkArt      String? // URL or identifier for card network logo
  issuerColorHint String? // Hex color for card UI
  // The BANK's name ("PNC Bank"), from Plaid's institution lookup at link
  // time — distinct from displayName, which is the account's own nickname
  // ("Spend", "Checking Plus"). The wallet card shows this as the primary
  // issuer label; a real card says the bank's name, not the account's.
  institutionName String?
  // Plaid's own stable account identifier (`account.account_id`) — the ONLY
  // reliable key for matching a synced transaction back to the funding
  // instrument it belongs to. `last4` is NOT unique enough on its own (two
  // real accounts can share a mask) and was never the actual bug here: the
  // sync path was deriving a fake "mask" from the last 4 CHARACTERS of
  // `transaction.account_id` — an opaque Plaid id, not a digit string — so
  // it essentially never matched and every charge silently fell back to
  // whichever instrument happened to be first in the array. See the note in
  // syncTransactionsForItem (apps/api/src/routes/plaid.ts).
  plaidAccountId  String?
  // Plaid's account.subtype ('checking', 'savings', 'credit card', ...) —
  // display-only (Settings' bank-detail screen labels an account "Checking"
  // vs "Savings"). Pay in 4 ELIGIBILITY does not read this: `type == 'bank'`
  // (i.e. not a credit card) is already the complete eligibility check, since
  // `type` only ever collapses to 'card' (credit) or 'bank' (any depository).
  subtype         String?
  // The owning PlaidItem, so Settings can group accounts by bank and a
  // per-item disconnect (DELETE /plaid/items/:id) can cascade-delete the
  // accounts that came from it. Nullable because this backfilled onto rows
  // created before the column existed — a NULL itemId just means "predates
  // grouping," not "orphaned."
  itemId          String?
  item            PlaidItem?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Which product this bank link was made FOR, when the user linked it from
  // a specific flow rather than general onboarding. Null means "general" —
  // it can back subscriptions, Wallet, anything. 'pay_in_4' means the user
  // connected this account specifically from the Spending Power screen, so
  // Settings' linked-banks list can show it under Pay in 4 rather than mixed
  // in with Card subscription-tracking banks. Purely a UI grouping label —
  // every linked account is read the same way everywhere else (sync,
  // trust-score signals, subscriptions).
  purpose         String?
  isDefault       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionCharges SubscriptionCharge[]

  @@index([userId])
  @@index([itemId])
}

// ============================================================================
// Merchant & Subscription Models
// ============================================================================

model Merchant {
  id                        String    @id @default(cuid())
  canonicalName             String    @unique
  fingerprintKeys           Json // { domains: [], descriptors: [], patterns: [] }
  logo                      String? // URL or path
  // Plaid's own `transaction.website` for this merchant, when it supplies
  // one — the domain source that makes cancellation auto-discovery
  // (apps/mobile/utils/cancellation.ts) work for the long tail of
  // merchants nobody hand-curated a cancel URL for. Nullable: Plaid does
  // not return a website for every merchant.
  website                   String?
  cancellationDifficulty    Int       @default(3) // 1-5
  difficultyLastUpdatedAt   DateTime  @default(now())
  cancellationPlaybook      Json? // { url, steps, expectedEndState, retentionSteps, requiresLogin }
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  subscriptions       Subscription[]
  subscriptionCharges SubscriptionCharge[]
  cancelAttempts      CancelAttempt[]
  proofArtifacts      ProofArtifact[]

  @@index([canonicalName])
}

enum SubscriptionStatus {
  active
  trial
  canceled
  paused
}

enum SubscriptionCadence {
  monthly
  yearly
  weekly
  unknown
}

model Subscription {
  id          String              @id @default(cuid())
  userId      String
  merchantId  String
  status      SubscriptionStatus
  cadence     SubscriptionCadence @default(unknown)
  renewalDate DateTime?
  startedAt   DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  trial           Trial?
  priceHistory    PriceHistory[]
  cancelAttempts  CancelAttempt[]
  allocationPlans AllocationPlan[]

  @@index([userId])
  @@index([merchantId])
  @@index([status])
}

enum BillingInterval {
  monthly
  yearly
  weekly
  unknown
}

enum InferenceSource {
  transaction
  email
  sms
}

model SubscriptionCharge {
  id                  String           @id @default(cuid())
  userId              String
  merchantId          String
  merchantName        String
  amountCents         Int
  currency            String           @default("USD")
  billingInterval     BillingInterval  @default(unknown)
  chargeTimestamp     DateTime
  fundingInstrumentId String
  inferenceSource     InferenceSource
  confidenceScore     Float            @default(1.0) // 0.0 to 1.0
  evidenceRef         String? // Reference to raw transaction, email, or SMS
  createdAt           DateTime         @default(now())

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  fundingInstrument FundingInstrument @relation(fields: [fundingInstrumentId], references: [id])

  @@index([userId])
  @@index([merchantId])
  @@index([fundingInstrumentId])
  @@index([chargeTimestamp])
}

// ============================================================================
// Transaction & Trial Models
// ============================================================================

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  merchantNameRaw String
  amountCents     Int
  date            DateTime
  source          String // e.g., "csv_import", "plaid"
  rawData         Json? // Original transaction data
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Trial {
  id             String   @id @default(cuid())
  subscriptionId String   @unique
  trialEndDate   DateTime
  detectedFrom   String // e.g., "email", "sms"
  decisionRuleId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  decisionRule   DecisionRule?

  @@index([trialEndDate])
}

enum DecisionRuleType {
  autoCancel
  convertIfUsage
  convertIfBalance
  downgrade
}

model DecisionRule {
  id               String           @id @default(cuid())
  trialId          String           @unique
  type             DecisionRuleType
  usageThreshold   Int? // For convertIfUsage
  balanceThreshold Int? // For convertIfBalance in cents
  runAtDate        DateTime
  executed         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  trial Trial @relation(fields: [trialId], references: [id], onDelete: Cascade)

  @@index([runAtDate, executed])
}

// ============================================================================
// Price History
// ============================================================================

model PriceHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  month          String // Format: "YYYY-MM"
  amountCents    Int
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, month])
  @@index([subscriptionId])
}

// ============================================================================
// Cancellation Spine
// ============================================================================

enum CancelMethod {
  assisted
  manual
}

enum CancelStatus {
  in_progress
  proof_uploaded
  confirmed
  failed
}

model CancelAttempt {
  id               String        @id @default(cuid())
  subscriptionId   String
  merchantId       String
  startedAt        DateTime      @default(now())
  method           CancelMethod
  status           CancelStatus  @default(in_progress)
  proofArtifactId  String?       @unique
  cancellationUrl  String?
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  merchant       Merchant       @relation(fields: [merchantId], references: [id])
  proofArtifact  ProofArtifact? @relation(fields: [proofArtifactId], references: [id])

  @@index([subscriptionId])
  @@index([merchantId])
  @@index([status])
}

enum ProofFileType {
  image
  email
}

model ProofArtifact {
  id              String        @id @default(cuid())
  merchantId      String
  cancelAttemptId String        @unique
  fileType        ProofFileType
  fileUri         String
  uploadedAt      DateTime      @default(now())
  extractedText   String?       @db.Text
  verified        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  cancelAttempt CancelAttempt?

  @@index([merchantId])
}

// ============================================================================
// Reallocation & Ledger
// ============================================================================

enum AllocationTarget {
  savings
  debt
  investing
  subscription
}

model AllocationPlan {
  id             String           @id @default(cuid())
  userId         String
  subscriptionId String?
  month          String // Format: "YYYY-MM"
  amountCents    Int
  target         AllocationTarget
  note           String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([month])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  userId         String
  month          String // Format: "YYYY-MM"
  reclaimedCents Int
  allocatedCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

// ============================================================================
// Feature Flags
// ============================================================================

model UserFeatureFlag {
  id        String   @id @default(cuid())
  userId    String
  flagKey   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flagKey])
  @@index([userId])
}

// ============================================================================
// Plaid Integration
// ============================================================================

model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  plaidItemId     String    @unique
  accessTokenEnc  String    @db.Text
  institutionId   String?
  institutionName String?
  accounts        Json      // Array of Plaid account objects
  /// Whether /plaid/sync reads THIS item's transactions to find recurring
  /// charges. Defaults true — every pre-existing item and every general-
  /// purpose new link keeps working exactly as before. Only turns false when
  /// someone links a bank specifically for Pay in 4 (SpendingPowerSheet's
  /// "Connect a new bank") and declines subscription-reading in the purpose
  /// prompt, or later flips the "Read this bank for subscriptions" switch on
  /// Settings' bank-detail screen. Pay in 4's own assessment (trustScoring.ts)
  /// never checks this — a read-off bank still funds Pay in 4 fine, since
  /// balance/deposit signals are a different read than subscription-charge
  /// detection.
  readForSubscriptions Boolean @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundingInstruments FundingInstrument[]

  @@index([userId])
}

// ============================================================================
// Automated Goal Savings Engine
//
// Digit/Oportun-style: forecast the checking low point, sweep only the surplus
// above the user's buffer, hold funds through the ACH return window, and only
// then credit the goal.
//
// NAMING: the models below are deliberately NOT called LedgerEntry,
// FundingInstrument or AllocationPlan. Those names are already taken in this
// schema and mean something different — LedgerEntry is a monthly
// reclaimed/allocated summary, FundingInstrument is a display card with no ACH
// credentials, AllocationPlan is a monthly reallocation note. Reusing them
// would silently conflate two systems.
//
// MONEY: cents as Int, matching the rest of this schema. The source design
// specified BIGINT; Int caps at ~$21.4M per row, which is far above any
// consumer savings goal, and switching would make every amount a JS BigInt —
// which Fastify cannot JSON-serialise without a custom replacer. Revisit only
// if EZER ever handles business balances.
// ============================================================================

enum FundingSourceStatus {
  ACTIVE
  LOGIN_REQUIRED // Plaid item needs Link update-mode re-auth
  REVOKED
}

/// A real bank account we can ACH debit/credit. Distinct from FundingInstrument,
/// which is only a card for display.
model FundingSource {
  id             String              @id @default(cuid())
  userId         String
  plaidItemId    String
  plaidAccountId String
  /// KMS/Vault reference — NEVER the access token itself.
  accessTokenRef String
  /// Processor token (Dwolla/Increase/Column). Null until processor linkage.
  processorToken String?
  mask           String?
  subtype        String? // checking | savings
  status         FundingSourceStatus @default(ACTIVE)
  isPrimary      Boolean             @default(false)
  /// UI/engine grouping only, mirrors FundingInstrument.purpose — 'pay_in_4'
  /// when this is the bank the user linked specifically to repay Pay in 4.
  /// installmentEngine.ts prefers this tag over isPrimary when charging an
  /// installment; undefined means "use the primary source," same as before
  /// this field existed.
  purpose        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plaidAccountId])
  @@index([userId, isPrimary])
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETE
  CLOSED
}

model SavingsGoal {
  id          String            @id @default(cuid())
  userId      String
  name        String
  targetCents Int
  /// NULL = no deadline, so the goal never forces a required rate.
  targetDate  DateTime?
  /// Lower is funded first.
  priority    Int               @default(100)
  status      SavingsGoalStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule             GoalAllocationRule?
  internalAccounts InternalAccount[]
  transfers        Transfer[]

  @@index([userId, status])
}

enum AllocationMode {
  FIXED
  ADAPTIVE
}

enum AllocationCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  PAYDAY
}

model GoalAllocationRule {
  goalId           String            @id
  mode             AllocationMode    @default(ADAPTIVE)
  cadence          AllocationCadence @default(WEEKLY)
  /// FIXED mode only.
  fixedAmountCents Int?
  /// Hard ceiling for a single run.
  maxPeriodCents   Int?
  /// ADAPTIVE: share of forecast surplus to take. 0.25 timid … 0.75 aggressive.
  aggressiveness   Decimal           @default(0.50) @db.Decimal(3, 2)

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

/// Per-user safety rails. These are the difference between saving someone money
/// and overdrafting them.
model SavingsSettings {
  userId              String    @id
  /// Never sweep the checking balance below this.
  minCheckingCents    Int       @default(10000)
  maxWeeklyCents      Int       @default(50000)
  pausedUntil         DateTime?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InternalAccountKind {
  AVAILABLE
  GOAL
  IN_TRANSIT
  FBO_CASH
}

/// One bucket per (user, kind[, goal]) in the double-entry ledger.
model InternalAccount {
  id     String              @id @default(cuid())
  userId String
  kind   InternalAccountKind
  goalId String?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    SavingsGoal?         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  entries SavingsLedgerEntry[]

  @@unique([userId, kind, goalId])
  @@index([userId])
}

enum TransferDirection {
  DEBIT // bank -> us
  CREDIT // us -> bank
}

enum TransferStatus {
  PENDING
  SUBMITTED
  POSTED
  SETTLED
  FAILED
  RETURNED
  CANCELED
}

model Transfer {
  id          String            @id @default(cuid())
  userId      String
  goalId      String?
  /// Set only for a Pay in 4 repayment debit — mutually exclusive with goalId.
  /// Reuses this model's processor/idempotency/settlement machinery rather
  /// than duplicating it for a second money-moving subsystem; see
  /// services/installmentEngine.ts.
  installmentId String?
  direction   TransferDirection
  amountCents Int
  status      TransferStatus    @default(PENDING)
  /// hash(user, goal|installment, periodKey) — the processor-level idempotency lock.
  idempotencyKey String         @unique
  /// Processor's transfer id, known only after origination.
  externalId  String?           @unique
  /// R01 NSF, R02 account closed, R08 stop payment…
  returnCode  String?
  /// When funds clear the ACH return window and become withdrawable.
  settlesAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        SavingsGoal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  installment Installment?         @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  entries     SavingsLedgerEntry[]

  @@index([userId, status])
  @@index([goalId])
  @@index([installmentId])
}

/// Double-entry line. INVARIANT: SUM(amountCents) per transferId == 0.
/// Balances are DERIVED from these rows — there is no mutable balance column
/// anywhere in this subsystem, on purpose.
model SavingsLedgerEntry {
  id          BigInt   @id @default(autoincrement())
  transferId  String
  accountId   String
  /// Signed: + credits the bucket, - debits it.
  amountCents Int
  postedAt    DateTime @default(now())

  transfer Transfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  account  InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([transferId])
}

/// One row per user per period. The UNIQUE constraint is the real idempotency
/// lock that stops a retried cron run from double-charging someone.
model SweepRun {
  id        String   @id @default(cuid())
  userId    String
  /// e.g. '2026-W31' or '2026-07-31'
  periodKey String
  /// {goalId: cents} plus reason codes.
  decided   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId])
}

/// Processor webhook receipts.
///
/// Processors retry on ANY non-2xx and on timeouts, so the same event WILL
/// arrive more than once. For a subsystem that moves money, double-processing a
/// settlement is the failure that actually costs you — a missed webhook is
/// recoverable by reconciliation, a double-credit is not.
///
/// The unique index on eventId is the lock: insert first. A collision whose
/// existing receipt has processedAt set returns 2xx without re-running the
/// handler; processedAt null means a delivery died mid-handler, and that
/// retry re-runs the (idempotent) handlers instead of being deduped.
model ProcessorWebhookEvent {
  id          String   @id @default(cuid())
  /// The PROVIDER's event id, not ours.
  eventId     String   @unique
  provider    String
  eventType   String
  /// Raw body, retained for dispute/audit. Verified before it is parsed.
  rawBody     String   @db.Text
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([receivedAt])
}

// ============================================================================
// Card designer
//
// These replace two in-process Maps. Card designs and access-list decisions
// were held in memory, so every deploy — and Railway deploys on every push —
// silently erased every user's saved design and approval.
//
// userId is a plain String, not a relation, because designing a card is a
// pre-account action: `resolveUserId` returns the literal "anonymous" when
// there is no token, and a foreign key cannot point at a user that does not
// exist yet.
// ============================================================================

model CardDesign {
  id        String   @id @default(cuid())
  userId    String
  finish    String
  /// Array of { d, color, width }. Validated in routes/cards.ts before write.
  strokes   Json
  /// The client's own "last edited" time, echoed back to it. Untrusted for
  /// ordering, which is what createdAt is for.
  updatedAt DateTime
  createdAt DateTime @default(now())

  accessLists CardAccessList[]

  @@index([userId])
}

model CardAccessList {
  id         String   @id @default(cuid())
  userId     String
  designId   String?
  /// "plaid" | "waitlist"
  mode       String
  /// "waitlist" | "approved_pending_issuance" | "manual_review"
  status     String
  limitCents Int?
  trustScore Int?
  createdAt  DateTime @default(now())

  design CardDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
}

// ============================================================================
// Pay in 4 — installment charging engine
//
// Not live yet: nothing in the app currently lets someone actually SPLIT a
// purchase (payin4.tsx's own copy says "not yet available"). This schema and
// services/installmentEngine.ts exist so the "restrict tightly on a missed
// payment" half of the underwriting model (see cards.ts's scoreTrust) has
// something real to react to THE MOMENT a BIN sponsor/processor makes Pay in 4
// chargeable — no schema or scoring change needed at that point, only wiring
// a real purchase flow to createPlan() and a real cron to chargeDueInstallments().
// ============================================================================

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETE
  /// One or more installments went uncured past the grace period. The plan
  /// itself stays DEFAULTED even if a later installment on it settles — the
  /// user already missed one, which is the event scoreTrust penalizes.
  DEFAULTED
}

model InstallmentPlan {
  id         String                @id @default(cuid())
  userId     String
  totalCents Int
  status     InstallmentPlanStatus @default(ACTIVE)
  createdAt  DateTime              @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([userId, status])
}

enum InstallmentStatus {
  /// Not yet due, or due but not yet charged.
  PENDING
  /// Debit originated with the processor, awaiting settlement.
  SUBMITTED
  PAID
  /// Returned (NSF/etc.) and still past the grace period, uncured. This is
  /// the exact signal `scoreTrust` has nowhere to read from yet — see
  /// cards.ts's limitForScore comment.
  MISSED
  /// Was MISSED, then paid late. A cured installment is a paid one for
  /// scoring (trustScoring.deriveInstallmentSignals counts only MISSED), and
  /// it no longer blocks issuance; the plan it defaulted stays DEFAULTED.
  CURED
}

model Installment {
  id          String             @id @default(cuid())
  planId      String
  /// Denormalized from plan.userId — every query that matters here (charge
  /// what's due, score what's missed) is per-user, and joining through plan
  /// for that on every call is pure overhead.
  userId      String
  /// 1-based position in the plan (1 of 4, 2 of 4, …).
  n           Int
  amountCents Int
  dueDate     DateTime
  status      InstallmentStatus  @default(PENDING)
  paidAt      DateTime?
  missedAt    DateTime?
  createdAt   DateTime           @default(now())

  plan      InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  transfers Transfer[]

  @@unique([planId, n])
  @@index([planId])
  @@index([userId, status])
  @@index([status, dueDate])
}
