// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth & User Models
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authAccounts        AuthAccount[]
  oauthTokens         OAuthToken[]
  dataSources         DataSource[]
  fundingInstruments  FundingInstrument[]
  subscriptions       Subscription[]
  subscriptionCharges SubscriptionCharge[]
  transactions        Transaction[]
  allocationPlans     AllocationPlan[]
  ledgerEntries       LedgerEntry[]
  featureFlags        UserFeatureFlag[]
  plaidItems          PlaidItem[]

  // Automated goal savings engine
  fundingSources      FundingSource[]
  savingsGoals        SavingsGoal[]
  savingsSettings     SavingsSettings?
  internalAccounts    InternalAccount[]
  transfers           Transfer[]
  sweepRuns           SweepRun[]

  @@index([email])
}

enum AuthProvider {
  google
  apple
  microsoft
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum OAuthProvider {
  gmail
  outlook
}

model OAuthToken {
  id              String        @id @default(cuid())
  userId          String
  provider        OAuthProvider
  accessTokenEnc  String        @db.Text
  refreshTokenEnc String        @db.Text
  expiry          DateTime
  scopes          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum DataSourceType {
  gmail
  outlook
  imap
  sms
  csv
  eml_upload
}

enum DataSourceStatus {
  active
  error
  disabled
}

model DataSource {
  id        String           @id @default(cuid())
  userId    String
  type      DataSourceType
  status    DataSourceStatus @default(active)
  config    Json? // For IMAP credentials, etc.
  lastSyncAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Funding & Wallet Models
// ============================================================================

enum FundingInstrumentType {
  card
  bank
}

enum CardBrand {
  Visa
  Mastercard
  Amex
  Discover
  Bank
  Unknown
}

model FundingInstrument {
  id              String                @id @default(cuid())
  userId          String
  type            FundingInstrumentType
  displayName     String
  brand           CardBrand
  last4           String
  networkArt      String? // URL or identifier for card network logo
  issuerColorHint String? // Hex color for card UI
  isDefault       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionCharges SubscriptionCharge[]

  @@index([userId])
}

// ============================================================================
// Merchant & Subscription Models
// ============================================================================

model Merchant {
  id                        String    @id @default(cuid())
  canonicalName             String    @unique
  fingerprintKeys           Json // { domains: [], descriptors: [], patterns: [] }
  logo                      String? // URL or path
  cancellationDifficulty    Int       @default(3) // 1-5
  difficultyLastUpdatedAt   DateTime  @default(now())
  cancellationPlaybook      Json? // { url, steps, expectedEndState, retentionSteps, requiresLogin }
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  subscriptions       Subscription[]
  subscriptionCharges SubscriptionCharge[]
  cancelAttempts      CancelAttempt[]
  proofArtifacts      ProofArtifact[]

  @@index([canonicalName])
}

enum SubscriptionStatus {
  active
  trial
  canceled
  paused
}

enum SubscriptionCadence {
  monthly
  yearly
  weekly
  unknown
}

model Subscription {
  id          String              @id @default(cuid())
  userId      String
  merchantId  String
  status      SubscriptionStatus
  cadence     SubscriptionCadence @default(unknown)
  renewalDate DateTime?
  startedAt   DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  trial           Trial?
  priceHistory    PriceHistory[]
  cancelAttempts  CancelAttempt[]
  allocationPlans AllocationPlan[]

  @@index([userId])
  @@index([merchantId])
  @@index([status])
}

enum BillingInterval {
  monthly
  yearly
  weekly
  unknown
}

enum InferenceSource {
  transaction
  email
  sms
}

model SubscriptionCharge {
  id                  String           @id @default(cuid())
  userId              String
  merchantId          String
  merchantName        String
  amountCents         Int
  currency            String           @default("USD")
  billingInterval     BillingInterval  @default(unknown)
  chargeTimestamp     DateTime
  fundingInstrumentId String
  inferenceSource     InferenceSource
  confidenceScore     Float            @default(1.0) // 0.0 to 1.0
  evidenceRef         String? // Reference to raw transaction, email, or SMS
  createdAt           DateTime         @default(now())

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  fundingInstrument FundingInstrument @relation(fields: [fundingInstrumentId], references: [id])

  @@index([userId])
  @@index([merchantId])
  @@index([fundingInstrumentId])
  @@index([chargeTimestamp])
}

// ============================================================================
// Transaction & Trial Models
// ============================================================================

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  merchantNameRaw String
  amountCents     Int
  date            DateTime
  source          String // e.g., "csv_import", "plaid"
  rawData         Json? // Original transaction data
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Trial {
  id             String   @id @default(cuid())
  subscriptionId String   @unique
  trialEndDate   DateTime
  detectedFrom   String // e.g., "email", "sms"
  decisionRuleId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  decisionRule   DecisionRule?

  @@index([trialEndDate])
}

enum DecisionRuleType {
  autoCancel
  convertIfUsage
  convertIfBalance
  downgrade
}

model DecisionRule {
  id               String           @id @default(cuid())
  trialId          String           @unique
  type             DecisionRuleType
  usageThreshold   Int? // For convertIfUsage
  balanceThreshold Int? // For convertIfBalance in cents
  runAtDate        DateTime
  executed         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  trial Trial @relation(fields: [trialId], references: [id], onDelete: Cascade)

  @@index([runAtDate, executed])
}

// ============================================================================
// Price History
// ============================================================================

model PriceHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  month          String // Format: "YYYY-MM"
  amountCents    Int
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, month])
  @@index([subscriptionId])
}

// ============================================================================
// Cancellation Spine
// ============================================================================

enum CancelMethod {
  assisted
  manual
}

enum CancelStatus {
  in_progress
  proof_uploaded
  confirmed
  failed
}

model CancelAttempt {
  id               String        @id @default(cuid())
  subscriptionId   String
  merchantId       String
  startedAt        DateTime      @default(now())
  method           CancelMethod
  status           CancelStatus  @default(in_progress)
  proofArtifactId  String?       @unique
  cancellationUrl  String?
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  merchant       Merchant       @relation(fields: [merchantId], references: [id])
  proofArtifact  ProofArtifact? @relation(fields: [proofArtifactId], references: [id])

  @@index([subscriptionId])
  @@index([merchantId])
  @@index([status])
}

enum ProofFileType {
  image
  email
}

model ProofArtifact {
  id              String        @id @default(cuid())
  merchantId      String
  cancelAttemptId String        @unique
  fileType        ProofFileType
  fileUri         String
  uploadedAt      DateTime      @default(now())
  extractedText   String?       @db.Text
  verified        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  cancelAttempt CancelAttempt?

  @@index([merchantId])
}

// ============================================================================
// Reallocation & Ledger
// ============================================================================

enum AllocationTarget {
  savings
  debt
  investing
  subscription
}

model AllocationPlan {
  id             String           @id @default(cuid())
  userId         String
  subscriptionId String?
  month          String // Format: "YYYY-MM"
  amountCents    Int
  target         AllocationTarget
  note           String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([month])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  userId         String
  month          String // Format: "YYYY-MM"
  reclaimedCents Int
  allocatedCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

// ============================================================================
// Feature Flags
// ============================================================================

model UserFeatureFlag {
  id        String   @id @default(cuid())
  userId    String
  flagKey   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flagKey])
  @@index([userId])
}

// ============================================================================
// Plaid Integration
// ============================================================================

model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  plaidItemId     String    @unique
  accessTokenEnc  String    @db.Text
  institutionId   String?
  institutionName String?
  accounts        Json      // Array of Plaid account objects
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Automated Goal Savings Engine
//
// Digit/Oportun-style: forecast the checking low point, sweep only the surplus
// above the user's buffer, hold funds through the ACH return window, and only
// then credit the goal.
//
// NAMING: the models below are deliberately NOT called LedgerEntry,
// FundingInstrument or AllocationPlan. Those names are already taken in this
// schema and mean something different — LedgerEntry is a monthly
// reclaimed/allocated summary, FundingInstrument is a display card with no ACH
// credentials, AllocationPlan is a monthly reallocation note. Reusing them
// would silently conflate two systems.
//
// MONEY: cents as Int, matching the rest of this schema. The source design
// specified BIGINT; Int caps at ~$21.4M per row, which is far above any
// consumer savings goal, and switching would make every amount a JS BigInt —
// which Fastify cannot JSON-serialise without a custom replacer. Revisit only
// if EZER ever handles business balances.
// ============================================================================

enum FundingSourceStatus {
  ACTIVE
  LOGIN_REQUIRED // Plaid item needs Link update-mode re-auth
  REVOKED
}

/// A real bank account we can ACH debit/credit. Distinct from FundingInstrument,
/// which is only a card for display.
model FundingSource {
  id             String              @id @default(cuid())
  userId         String
  plaidItemId    String
  plaidAccountId String
  /// KMS/Vault reference — NEVER the access token itself.
  accessTokenRef String
  /// Processor token (Dwolla/Increase/Column). Null until processor linkage.
  processorToken String?
  mask           String?
  subtype        String? // checking | savings
  status         FundingSourceStatus @default(ACTIVE)
  isPrimary      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plaidAccountId])
  @@index([userId, isPrimary])
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETE
  CLOSED
}

model SavingsGoal {
  id          String            @id @default(cuid())
  userId      String
  name        String
  targetCents Int
  /// NULL = no deadline, so the goal never forces a required rate.
  targetDate  DateTime?
  /// Lower is funded first.
  priority    Int               @default(100)
  status      SavingsGoalStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule             GoalAllocationRule?
  internalAccounts InternalAccount[]
  transfers        Transfer[]

  @@index([userId, status])
}

enum AllocationMode {
  FIXED
  ADAPTIVE
}

enum AllocationCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  PAYDAY
}

model GoalAllocationRule {
  goalId           String            @id
  mode             AllocationMode    @default(ADAPTIVE)
  cadence          AllocationCadence @default(WEEKLY)
  /// FIXED mode only.
  fixedAmountCents Int?
  /// Hard ceiling for a single run.
  maxPeriodCents   Int?
  /// ADAPTIVE: share of forecast surplus to take. 0.25 timid … 0.75 aggressive.
  aggressiveness   Decimal           @default(0.50) @db.Decimal(3, 2)

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

/// Per-user safety rails. These are the difference between saving someone money
/// and overdrafting them.
model SavingsSettings {
  userId              String    @id
  /// Never sweep the checking balance below this.
  minCheckingCents    Int       @default(10000)
  maxWeeklyCents      Int       @default(50000)
  pausedUntil         DateTime?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InternalAccountKind {
  AVAILABLE
  GOAL
  IN_TRANSIT
  FBO_CASH
}

/// One bucket per (user, kind[, goal]) in the double-entry ledger.
model InternalAccount {
  id     String              @id @default(cuid())
  userId String
  kind   InternalAccountKind
  goalId String?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    SavingsGoal?         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  entries SavingsLedgerEntry[]

  @@unique([userId, kind, goalId])
  @@index([userId])
}

enum TransferDirection {
  DEBIT // bank -> us
  CREDIT // us -> bank
}

enum TransferStatus {
  PENDING
  SUBMITTED
  POSTED
  SETTLED
  FAILED
  RETURNED
  CANCELED
}

model Transfer {
  id          String            @id @default(cuid())
  userId      String
  goalId      String?
  direction   TransferDirection
  amountCents Int
  status      TransferStatus    @default(PENDING)
  /// hash(user, goal, periodKey) — the processor-level idempotency lock.
  idempotencyKey String         @unique
  /// Processor's transfer id, known only after origination.
  externalId  String?           @unique
  /// R01 NSF, R02 account closed, R08 stop payment…
  returnCode  String?
  /// When funds clear the ACH return window and become withdrawable.
  settlesAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    SavingsGoal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  entries SavingsLedgerEntry[]

  @@index([userId, status])
  @@index([goalId])
}

/// Double-entry line. INVARIANT: SUM(amountCents) per transferId == 0.
/// Balances are DERIVED from these rows — there is no mutable balance column
/// anywhere in this subsystem, on purpose.
model SavingsLedgerEntry {
  id          BigInt   @id @default(autoincrement())
  transferId  String
  accountId   String
  /// Signed: + credits the bucket, - debits it.
  amountCents Int
  postedAt    DateTime @default(now())

  transfer Transfer        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  account  InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([transferId])
}

/// One row per user per period. The UNIQUE constraint is the real idempotency
/// lock that stops a retried cron run from double-charging someone.
model SweepRun {
  id        String   @id @default(cuid())
  userId    String
  /// e.g. '2026-W31' or '2026-07-31'
  periodKey String
  /// {goalId: cents} plus reason codes.
  decided   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId])
}

/// Processor webhook receipts.
///
/// Processors retry on ANY non-2xx and on timeouts, so the same event WILL
/// arrive more than once. For a subsystem that moves money, double-processing a
/// settlement is the failure that actually costs you — a missed webhook is
/// recoverable by reconciliation, a double-credit is not.
///
/// The unique index on eventId is the lock: insert first, and if it collides,
/// return 2xx immediately without re-running the handler.
model ProcessorWebhookEvent {
  id          String   @id @default(cuid())
  /// The PROVIDER's event id, not ours.
  eventId     String   @unique
  provider    String
  eventType   String
  /// Raw body, retained for dispute/audit. Verified before it is parsed.
  rawBody     String   @db.Text
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([receivedAt])
}
