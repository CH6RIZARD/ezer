# Database
DATABASE_URL="postgresql://ezer:ezer_dev_password@localhost:5432/ezer"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"

# Encryption (for OAuth tokens)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-change-in-production"

# API
API_PORT=3001
API_HOST=localhost

# Worker
WORKER_CONCURRENCY=5

# Dev Mode
DEV_OAUTH_BYPASS=true
NODE_ENV=development

# OAuth - Google (Production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/oauth/google/callback"

# OAuth - Microsoft (Production)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/auth/oauth/microsoft/callback"

# OAuth - Apple (Production)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Feature Flags
FEATURE_PLAID=false
FEATURE_APPSTORE=false

# Plaid (required when FEATURE_PLAID=true)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Frontend
EXPO_PUBLIC_API_URL="http://localhost:3001"
