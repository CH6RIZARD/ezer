# Database
DATABASE_URL="postgresql://ezer:ezer_dev_password@localhost:5432/ezer"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — required in production
JWT_SECRET="your-jwt-secret-change-in-production"

# Encryption (for OAuth tokens)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-change-in-production"

# API
API_PORT=3001
API_HOST=0.0.0.0

# Worker
WORKER_CONCURRENCY=5

# Demo / simulator routes — keep false for deploy-ready builds
DEV_OAUTH_BYPASS=false
NODE_ENV=development

# -----------------------------------------------------------------------------
# Google Auth Platform (native iOS + Android)
# Create clients under: Google Cloud Console → Google Auth Platform → Clients
#   1) Web application  → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID + GOOGLE_WEB_CLIENT_ID
#      (needed so the SDK returns an ID token the API can verify)
#   2) iOS              → bundle ID com.ezer.app → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#   3) Android          → package com.ezer.app + SHA-1 → GOOGLE_ANDROID_CLIENT_ID
# Enable Gmail API if you will connect inboxes later.
# Audience: External + add Test users while in Testing.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/oauth/google/callback"

# Mobile (Expo) — same Google client IDs, public to the app bundle
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_CLIENT_ID=""

# -----------------------------------------------------------------------------
# Microsoft Entra (Azure AD) app registration
# Redirect URI (mobile): ezer://auth/microsoft
# Also add the same value under Mobile/desktop redirect URIs.
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/auth/oauth/microsoft/callback"
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=""

# -----------------------------------------------------------------------------
# Apple Sign In
# APPLE_CLIENT_ID / APPLE_BUNDLE_ID should be com.ezer.app (Services ID if using web)
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID="com.ezer.app"
APPLE_BUNDLE_ID="com.ezer.app"
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Feature Flags
FEATURE_PLAID=false
FEATURE_APPSTORE=false

# Plaid (required when FEATURE_PLAID=true)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Frontend → API (use your machine LAN IP for a physical phone)
EXPO_PUBLIC_API_URL="http://localhost:3001"
