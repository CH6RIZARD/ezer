{
  "name": "@ezer/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "dev": "expo start --dev-client --lan",
    "tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:dev": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "clean": "rm -rf .expo node_modules android ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@ezer/shared": "workspace:*",
    "@ezer/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "axios": "^1.6.5",
    "expo": "54.0.32",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "8.0.11",
    "expo-router": "6.0.22",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.17",
    "typescript": "^5.3.3"
  }
}
