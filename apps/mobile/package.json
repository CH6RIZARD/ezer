{
  "name": "@ezer/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "dev": "expo start --dev-client --lan",
    "tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:dev": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "clean": "rm -rf .expo node_modules android ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "55.0.4-canary-20260128-67ce8d5",
    "@ezer/shared": "workspace:*",
    "@ezer/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "axios": "^1.6.5",
    "expo": "55.0.0-canary-20260128-67ce8d5",
    "expo-build-properties": "~55.0.4",
    "expo-constants": "55.0.3-canary-20260128-67ce8d5",
    "expo-dev-client": "~55.0.3",
    "expo-image-picker": "~55.0.3",
    "expo-linking": "55.0.4-canary-20260128-67ce8d5",
    "expo-router": "55.0.0-canary-20260128-67ce8d5",
    "expo-status-bar": "~55.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.10",
    "typescript": "^5.3.3"
  }
