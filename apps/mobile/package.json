{
  "name": "@ezer/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "dev": "expo start --dev-client --lan",
    "tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:dev": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "clean": "rm -rf .expo node_modules android ios"
  },
  "dependencies": {
    "@ezer/shared": "workspace:*",
    "@ezer/ui": "workspace:*",
    "@expo/metro-runtime": "~5.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "expo": "~54.0.0",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-image-picker": "~16.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "axios": "^1.6.5",
    "@react-native-async-storage/async-storage": "2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "^5.3.3"
  }
}
