{
  "expo": {
    "name": "EZER",
    "slug": "ezer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000",
      "dark": {
        "image": "./assets/splash-blank.png",
        "backgroundColor": "#000000"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ezersaves.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "backgroundColor": "#000000",
      "package": "com.ezersaves.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "EZER",
      "shortName": "EZER",
      "display": "standalone",
      "themeColor": "#F7F3EA",
      "backgroundColor": "#F7F3EA"
    },
    "scheme": "ezer",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "37fb7548-df7c-4bff-a745-98b927cc1d84"
      }
    },
    "owner": "ch6ze"
  }
}
